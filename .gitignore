# ---------------------------------------------------------------------------
# .gitignore - generated artefacts, local state, and secrets never enter git.
#
# Verify one path before adding a rule:   git check-ignore -v <path>
# Confirm nothing tracked is silently ignored:
#   git ls-files -ci --exclude-standard     (must print nothing)
#
# Order: noise -> legacy toolchains -> IDE -> build -> node -> python ->
#        pixi -> secrets -> agent layers -> local notes -> clones -> bindings
# ---------------------------------------------------------------------------

# --- OS / editor temporary noise -------------------------------------------
*~
*.autosave
*.core
*.orig
*.rej
.#*
*.*#
tags
.DS_Store
.directory
Thumbs.db
*.debug
*.app
# xemacs temporary files
*.flc
# vim swap files
.*.swp

# --- Visual Studio / MinGW (legacy template, kept for Windows contributors) --
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*
*.Debug
*.Release
*.dll
*.exe

# --- IDE local configuration ------------------------------------------------
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# --- Build and test outputs -------------------------------------------------
# out/ is the assembly root; build/ holds the book and other derived trees.
/out/
/build/
/target/
/dist/
/install/
/log/
cmake-build*/
/Testing/
# in-source build accidents
CMakeCache.txt
CMakeFiles/
# clangd database and per-user CMake presets
/compile_commands.json
/CMakeUserPresets.json
# llvm-cov default profraw litter
*.profraw

# --- Node / MCP bridge (root manifests are npm state, not project files) ----
node_modules/
/package.json
/package-lock.json
.npm-cache/
.turbo/
*.node

# --- Python -----------------------------------------------------------------
*.pyc
__pycache__/
.venv-openspace/

# --- pixi environment manager ----------------------------------------------
.pixi/
.pixi-pack/
.pixi-cache/

# --- Local secrets and overrides (never track) ------------------------------
# Canonical .agents/mcp.json is committed; this file carries real credentials.
.agents/mcp.local.json
# local environment files (the .example template stays committable)
.env
.env.local
.env.*.local
!.env.example
# local TLS artefacts
.certs/
# local tool caches
.cache/

# --- Agent host layers (generated from .agents/; never hand-edit) -----------
.codebuddy/
.qoder/
.trae/
.claude/
.cursor/
.playwright-mcp/
.codegraph/
# CodeGraph CLI and bin links (installed by init-mcp-codegraph.sh)
.opencode/codegraph/
.opencode/bin/
.opencode/*.bak-*
# Serena generated state (project.yml stays tracked by design)
/.serena/cache/
/.serena/memories/
/.serena/project.local.yml

# --- Local planning / scaffolding ------------------------------------------
.omo/*
!.omo/omo.jsonc
.sisyphus/
# legacy temp dirs (no current user; confirm before removing)
/stash/
/nodejs/

# --- Activation wrappers ----------------------------------------------------
# ModuKit tracks pixi.sh / pixi.bat / pixi.ps1 as documented entry points.
# (Unlike VE, these are not generated-and-ignored here.)

# --- Script-managed reference clones (read-only) ----------------------------
/.refinfo/

# --- Repo-local tool binaries ----------------------------------------------
/.tools/

# --- Generated language skins ----------------------------------------------
# The wave-2 python demo re-emits this file through the codegen door; the
# byte-pinned face lives in crates/modukit-codegen/testdata/golden.
# plugin_runtime.py is hand-written and TRACKED (D106 batch-2 T2.4): the
# directory-exclusion form cannot be re-included by a negation (git never
# descends), hence bindings/py/* + an explicit !-line.
bindings/py/*
!bindings/py/plugin_runtime.py
