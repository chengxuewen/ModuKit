*.pyc

# Binaries
# --------
*.dll
*.exe

# IDE files
# --------
.vs
.idea
.cache
.vscode/*
!.vscode/settings.json

# Build dirs
# --------
out
log
dist
build
target
*.node
/install

# Temp dirs
# --------
nodejs
stash

# nodejs environments
node_modules
.npm-cache
.turbo

# Root npm echoes for the MCP single source (pins live in scripts/mcp-servers.json)
/package.json
/package-lock.json

# Local MCP credentials (canonical .agents/mcp.json is committed)
.agents/mcp.local.json

# Don't ignore files
# --------
!.vscode/settings.json

# Agent dirs
.venv-openspace
.playwright-mcp
.codegraph
# CodeGraph CLI + bin links (installed by init-mcp-codegraph.sh)
.opencode/codegraph/
.opencode/bin/
# Qoder host layer (generated by the IDE; never tracked)
.qoder/
.opencode/*.bak-*
# Serena generated state (project.yml stays tracked)
/.serena/cache/
/.serena/memories/
/.serena/project.local.yml
# pixi environment manager
.pixi
.pixi-pack
.pixi-cache
.sisyphus/
.omo/*
!.omo/omo.jsonc

# PolyOrch is now a tracked git submodule (D64-D67, M1 landing 2026-10-15) - the gitlink
# pin is the version authority (D67); the old ignore-for-reference-checkout entry retired.

# Build/delivery root for the assembly layer (PIT-210 lesson: generated trees live
# here, never inside the source tree; ignoring out/ is correct because it is derived)
out/

# Script-managed reference clones (codegraph/ecosystem tooling)
.refinfo


# in-source build accidents
CMakeCache.txt
CMakeFiles/

/Testing/

# Rust build artifacts
/target

# cargo build tree (out/ is the assembly root; both derived, never committed)
target/

# llvm-cov default profraw litter (spawned children + uninstrumented exit paths)
*.profraw


# regenerated live skin for the wave-2 python band (scripts/demo-wave2-py.sh
# re-emits it through the codegen door; the byte-pinned face lives in
# crates/modukit-codegen/testdata/golden/modukit_embed.py - never hand-commit).
# The hand-written plugin runtime is TRACKED (D106 batch-2 T2.4): the dir-
# exclusion form cannot be re-included by a negation (git never descends),
# hence bindings/py/* + an explicit !-line, proven both ways via check-ignore.
bindings/py/*
!bindings/py/plugin_runtime.py
