{
  "mcpServers": {
    "local-codegraph": {
      "args": [
        "scripts/agents/mcp-launch.sh",
        "mcp-codegraph"
      ],
      "command": "bash",
      "type": "stdio"
    },
    "local-playwright": {
      "args": [
        "scripts/agents/mcp-launch.sh",
        "mcp-playwright"
      ],
      "command": "bash",
      "type": "stdio"
    },
    "local-serena": {
      "args": [
        "scripts/agents/mcp-launch.sh",
        "-e",
        "serena",
        "mcp-serena"
      ],
      "command": "bash",
      "type": "stdio"
    }
  }
}
